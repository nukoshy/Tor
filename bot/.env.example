# ===== WhatsApp gateway (WAHA) =====
WAHA_URL=http://localhost:3001
WAHA_API_KEY=поставь-тот-же-ключ-что-в-WAHA
WAHA_SESSION=default

# ===== Модель (OpenAI-совместимый API) =====
# DeepSeek:  https://api.deepseek.com/v1        модель deepseek-chat
# Qwen:      https://dashscope-intl.aliyuncs.com/compatible-mode/v1   модель qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== Распознавание голосовых (Whisper, ключ Groq — бесплатный тариф) =====
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3

# ===== Google Calendar (см. README, раздел «Календарь») =====
# base64 от JSON-ключа сервисного аккаунта:  base64 -i sa.json | tr -d '\n'
GOOGLE_SA_JSON_B64=
CALENDAR_ID=

# ===== Поведение =====
PORT=3000
# Секрет вебхука: WHATSAPP_HOOK_URL в WAHA должен заканчиваться на /webhook?token=<это значение>
WEBHOOK_TOKEN=придумай-длинный-секрет
# Сколько ждать менеджера-человека перед ответом бота (мс). 150000 = 2,5 минуты
REPLY_DELAY_MS=150000
# Если менеджер написал в чате — бот молчит столько минут после его последнего сообщения
HUMAN_COOLDOWN_MIN=60
# Куда слать уведомления о заявках (по умолчанию — «Избранное» самого номера)
ALERT_PHONE=77773539587
# Брони максимум за столько дней
MAX_ADVANCE_DAYS=31
